# Copy to api/.env for local dev. Never commit real values.
ENDOR_MODE=mock
ENDOR_API_KEY=
DATABASE_URL=
PROXY_SECRET=dev-proxy-secret
GAME_PAUSED=false
MAX_DAILY_USD=5
MAX_DAILY_TOKENS=5000000
WARM_SECRET=
IP_HASH_SALT_SEED=
TURNSTILE_SECRET=
REVEAL_VIDEO_ID=

# Live smoke test only (uv run pytest -m live): a model id like <project>/<base id>
ENDOR_SMOKE_MODEL=

# dev | prod. prod refuses to start without DATABASE_URL, random 32+ char PROXY_SECRET
# and IP_HASH_SALT_SEED, and COOKIE_SECURE=true (its default in prod).
APP_ENV=dev
COOKIE_SECURE=false
# Store contract tests also run against Postgres when this is set (a throwaway
# schema is created and dropped per test). Never point it at production.
TEST_DATABASE_URL=
